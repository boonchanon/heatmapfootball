# Local machine only.  Do not commit a real .env.local file.
# Replace with the Vercel production URL after deploying the frontend.
ALLOWED_ORIGINS=https://your-production.vercel.app
# Maximum incoming video size. Cloudflare Free proxy accepts at most 100 MiB.
# MAX_JOB_MB takes precedence over the legacy MAX_UPLOAD_BYTES setting.
MAX_JOB_MB=100
# Maximum frames accepted per analysis job (7200 = four minutes at 30 FPS).
MAX_ANALYSIS_FRAMES=7200
# Give the local machine a limit appropriate for its RAM, in MiB.
MAX_JOB_RSS_MB=12000
# Optional: keep job files outside the repository.
# WEB_JOBS_DIR=D:\\PitchsideJobs
